{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Pico Debug (Cortex-Debug)",
      "cwd": "${config:zephyrExperiments.openocdScripts}",
      "executable": "${workspaceFolder}/${config:zephyrExperiments.buildDir}/zephyr/zephyr.elf",
      "request": "launch",
      "type": "cortex-debug",
      "servertype": "openocd",
      "serverpath": "${config:zephyrExperiments.openocdPath}",
      "gdbPath": "${config:zephyrExperiments.gdbPath}",
      "device": "RP2350",
      "configFiles": [
          "interface/cmsis-dap.cfg",
          "target/rp2350.cfg"
      ],
      "svdFile": "${config:zephyrExperiments.svdFile}",
      "runToEntryPoint": "main",
      // Fix for no_flash binaries, where monitor reset halt doesn't do what is expected
      // Also works fine for flash binaries
      "overrideLaunchCommands": [
          "monitor reset init",
          "load \"${workspaceFolder}/${config:zephyrExperiments.buildDir}/zephyr/zephyr.elf\""
      ],
      "openOCDLaunchCommands": [
          "adapter speed 5000"
      ]
    },
    {
      "name": "Zephyr Workbench Debug",
      "type": "cppdbg",
      "request": "launch",
      "cwd": "${config:zephyrExperiments.openocdScripts}",
      "program": "${workspaceFolder}/${config:zephyrExperiments.buildDir}/zephyr/zephyr.elf",
      "args": [],
      "stopAtEntry": true,
      "svdPath": "",
      "environment": [],
      "externalConsole": false,
      "serverLaunchTimeout": 30000,
      "filterStderr": true,
      "filterStdout": true,
      "serverStarted": "halted due to debug-request, current mode: Thread",
      "MIMode": "gdb",
      "miDebuggerPath": "${config:zephyrExperiments.gdbPath}",
      "debugServerPath": "${workspaceFolder}/${config:zephyrExperiments.buildDir}/.debug/west_wrapper.sh",
      "debugServerArgs": "debugserver --build-dir \"${workspaceFolder}/${config:zephyrExperiments.buildDir}\" --runner openocd --gdb-port 3333 --openocd ${config:zephyrExperiments.openocdPath} --openocd-search ${config:zephyrExperiments.openocdScripts} --config openocd.cfg --config ${workspaceFolder}/${config:zephyrExperiments.buildDir}/.debug/gdb.cfg",
      "setupCommands": [
        {
          "text": "-environment-cd ${workspaceFolder}/${config:zephyrExperiments.buildDir}/zephyr"
        },
        {
          "text": "-target-select remote localhost:3333",
          "description": "connect to target",
          "ignoreFailures": false
        },
        {
          "text": "-file-exec-and-symbols zephyr.elf",
          "description": "load file",
          "ignoreFailures": false
        },
        {
          "text": "-interpreter-exec console \"monitor reset\"",
          "ignoreFailures": false
        },
        {
          "text": "-target-download",
          "description": "flash target",
          "ignoreFailures": false
        },
        {
          "text": "set breakpoint pending on",
          "description": "Set pending",
          "ignoreFailures": false
        },
        {
          "text": "tbreak main",
          "description": "Set a breakpoint at main",
          "ignoreFailures": true
        }
      ],
      "logging": {
        "moduleLoad": true,
        "trace": true,
        "engineLogging": true,
        "programOutput": true,
        "exceptions": true
      }
    }
  ]
}
